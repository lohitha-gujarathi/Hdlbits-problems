//Vector Concatenation: Concatenation needs to know the width of every component ,
The concatenation operator can be used on both the left and right sides of assignments.
// Combine six 5-bit inputs (30 bits) and append two '1' bits to make 32 bits.
// Split the 32-bit result into four 8-bit outputs using concatenation.
module top_module (
    input [4:0] a, b, c, d, e, f,
    output [7:0] w, x, y, z );//
    assign {w,x,y,z}={a,b,c,d,e,f ,2'b11};
  

endmodule
